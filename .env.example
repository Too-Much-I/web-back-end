MONGODB_URI=mongodb://localhost:27017/tosunsaeng-db
REDIS_HOST=localhost
REDIS_PORT=6379
AWS_ACCESS_KEY=test-access-key
AWS_SECRET_KEY=test-secret-key
AWS_S3_BUCKET_NAME=test-bucket

# 익명 댓글 token HMAC용 운영 secret을 별도 secret manager에서 주입하세요.
BLOG_ANONYMOUS_TOKEN_SECRET=
# 운영은 true, 로컬 HTTP 개발 환경에서만 false를 사용하세요.
BLOG_ANONYMOUS_COOKIE_SECURE=true
BLOG_ANONYMOUS_COOKIE_MAX_AGE_DAYS=180
# 실제 CloudFront 주소는 배포 환경에서 주입하세요.
BLOG_ANONYMOUS_AVATAR_BASE_URL=
# avatar-options의 noun/image-key 목록은 외부 application 설정으로 주입하세요.
