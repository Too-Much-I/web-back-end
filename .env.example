MONGODB_URI=mongodb://localhost:27017/tosunsaeng-db
REDIS_HOST=localhost
REDIS_PORT=6379
AWS_ACCESS_KEY=test-access-key
AWS_SECRET_KEY=test-secret-key
AWS_S3_BUCKET_NAME=test-bucket

# 익명 댓글 token HMAC용 운영 secret을 별도 secret manager에서 주입하세요.
BLOG_ANONYMOUS_TOKEN_SECRET=
# 운영은 true, 로컬 HTTP 개발 환경에서만 false를 사용하세요.
BLOG_ANONYMOUS_COOKIE_SECURE=true
BLOG_ANONYMOUS_COOKIE_MAX_AGE_DAYS=180
# 실제 CloudFront 주소는 배포 환경에서 주입하세요.
BLOG_ANONYMOUS_AVATAR_BASE_URL=
# avatar-options의 noun/image-key 목록은 외부 application 설정으로 주입하세요.

# 댓글 IP·내용 HMAC용 운영 secret입니다. 익명 token secret과 반드시 다른 값을 주입하세요.
BLOG_COMMENT_RATE_LIMIT_SECRET=
# 운영 기본값은 true이며, 장애 대응 등 명시적인 경우에만 비활성화하세요.
BLOG_COMMENT_RATE_LIMIT_ENABLED=true
# 동일 방문자·게시글·내용 중복 reservation 유지 시간(초)입니다.
BLOG_COMMENT_DUPLICATE_TTL_SECONDS=600

# 뉴스레터 구독 해지 link 서명용 active HMAC secret입니다. 다른 모든 secret과 분리하세요.
NEWSLETTER_UNSUBSCRIBE_TOKEN_SECRET=
# 현재 서명 key의 비밀값이 아닌 식별자입니다. 예: 배포 세대별 key ID
NEWSLETTER_UNSUBSCRIBE_TOKEN_KEY_ID=
# 과거 검증 key map은 저장소가 아닌 외부 YAML/config tree 또는 secret manager로 주입하세요.

# 뉴스레터 구독 IP rate limit HMAC용 운영 secret입니다. 다른 모든 secret과 분리하세요.
NEWSLETTER_SUBSCRIBE_RATE_LIMIT_SECRET=
# 운영 기본값은 true이며 테스트나 명시적인 장애 대응에서만 비활성화하세요.
NEWSLETTER_SUBSCRIBE_RATE_LIMIT_ENABLED=true

# 뉴스레터 실제·가짜 provider 호출의 master switch입니다. 기본값은 false입니다.
NEWSLETTER_SENDING_ENABLED=false
# logging 또는 ses를 사용합니다. local/test는 logging을 유지하세요.
NEWSLETTER_EMAIL_PROVIDER=logging
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_FROM_NAME=토선생
# 게시글과 frontend 구독 해지 확인 페이지의 public origin입니다.
NEWSLETTER_PUBLIC_BASE_URL=
# RFC 8058 one-click POST를 제공하는 API origin입니다.
NEWSLETTER_API_BASE_URL=
NEWSLETTER_SEND_DELAY_MINUTES=15
NEWSLETTER_BATCH_SIZE=100
NEWSLETTER_WORKER_COUNT=2
NEWSLETTER_QUEUE_CAPACITY=100
NEWSLETTER_CLAIM_TTL_SECONDS=300
NEWSLETTER_RECONCILIATION_DELAY_MS=60000
NEWSLETTER_CAMPAIGN_DELAY_MS=10000
NEWSLETTER_DELIVERY_DELAY_MS=5000
NEWSLETTER_RETRY_DELAY_MS=30000
NEWSLETTER_COMPLETION_DELAY_MS=30000
NEWSLETTER_STALE_RECOVERY_DELAY_MS=60000
# 테스트 발송은 master switch와 이 switch를 모두 켜고 allowlist 수신자만 사용합니다.
NEWSLETTER_TEST_SENDING_ENABLED=false
NEWSLETTER_TEST_RECIPIENT_ALLOWLIST=
# SES는 access key를 새로 주입하지 않고 EC2 IAM Role 또는 기본 credential chain을 사용합니다.
AWS_REGION=ap-northeast-2
